# Fire Detection Frame API Server Configuration

# Server Configuration
API_PORT=3001
NODE_ENV=development

# CORS Configuration
API_CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atmarakshak
DB_USER=postgres
DB_PASSWORD=postgres

# Database Test Configuration (optional)
DB_TEST_NAME=atmarakshak_test

# Database SSL Configuration (production)
# DB_SSL_REJECT_UNAUTHORIZED=true

# pgAdmin Configuration (optional)
PGADMIN_EMAIL=admin@atmarakshak.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Frame Storage Configuration
FRAME_STORAGE_PATH=data/fire_incidents

# Frame Extraction Configuration
FRAME_SAMPLE_RATE=5.0
FRAME_WINDOW_DURATION=30
FRAME_MIN_SELECTION=6
FRAME_MAX_SELECTION=15
FRAME_SIMILARITY_THRESHOLD=0.85
FRAME_IMAGE_QUALITY=90
