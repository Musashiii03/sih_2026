{
  "name": "fire-detection-api",
  "version": "1.0.0",
  "description": "Node.js Express API server for serving fire frame data from the YOLOv8 fire detection system",
  "main": "server.js",
  "scripts": {
    "postinstall": "node scripts/db-setup.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:db": "node test_database_connection.js",
    "test:email": "node scripts/test-email.js",
    "db:setup": "node scripts/db-setup.js",
    "migrate": "node scripts/migrate-database.js",
    "reset:db": "node scripts/reset-database.js",
    "seed:demo": "node scripts/setup-demo-data.js",
    "sync:incidents": "node scripts/sync-incidents.js",
    "update:fire-stations": "node scripts/update-nearest-fire-stations.js"
  },
  "keywords": [
    "fire-detection",
    "yolov8",
    "express",
    "api",
    "frame-extraction"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "js-yaml": "^5.4.1",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
