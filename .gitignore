# ═══════════════════════════════════════════════
# ATMARAKSHAK — .gitignore
# ═══════════════════════════════════════════════

# ── Node / npm ──────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ── Vite / Build output ─────────────────────────
dist/
dist-ssr/
build/
.vite/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ── Environment variables ───────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ── ML Models (large binary files — use Git LFS or store separately) ──
models/*.pt
models/*.pth
models/*.onnx
models/*.tflite
models/*.pb
models/*.bin
*.pt
*.pth
*.onnx
*.weights
*.h5

# ── Python ──────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt
.venv/
venv/
env/
ENV/
.env/
*.egg-info/
dist/
build/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
.installed.cfg
*.egg
MANIFEST

# ── Jupyter Notebooks ───────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS generated ────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE / Editor ────────────────────────────────
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ── VSCode (keep settings, ignore workspace private) ──
.vscode/launch.json
.vscode/ipch/

# ── Logs ────────────────────────────────────────
logs/
*.log
*.log.*

# ── Test / Coverage ─────────────────────────────
coverage/
.nyc_output/
*.lcov
.cache/

# ── Temp / Misc ─────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
.tmp/
tmp/
temp/
