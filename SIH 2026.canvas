		{"id":"4328b5a8b94c1a94","type":"text","text":"Future Scope if collabed\n","x":1480,"y":310,"width":250,"height":60},
		{"id":"60a08d12e781cd44","type":"text","text":"Fire Department Main Panel","x":1480,"y":475,"width":250,"height":50},
		{"id":"18d50e6c472e65cd","type":"text","text":"Fire Department Dashboard","x":1160,"y":590,"width":250,"height":60},
		{"id":"d146df4822db78ea","type":"text","text":"domain.com/building/id:","x":1160,"y":730,"width":250,"height":60},
		{"id":"0ab46471e05f51e6","type":"text","text":"Owner Dashboard","x":710,"y":590,"width":250,"height":60},
		{"id":"727caef6d3f3e7c7","type":"text","text":"CCTV Footages, past alert, current alert","x":710,"y":720,"width":250,"height":60},
		{"id":"10768fc026c53978","type":"text","text":"Create Dashboard\nincluding :\n- Images\n- location\n- hologram\n- nearest fire department\n- building information\n- owner information\n- possible victims\n- fire status","x":70,"y":1220,"width":280,"height":260},
		{"id":"4e9794419c1d09a6","type":"text","text":"Create a secure link of the dashboard","x":586,"y":1305,"width":250,"height":60},
		{"id":"4d5075eebae962ad","type":"text","text":"Contact the authorized emergency dispatch/control-room system","x":960,"y":1305,"width":320,"height":60},
		{"id":"a428ddbff5bd02fb","type":"text","text":"Through **India's Emergency Response Support System (ERSS)**","x":985,"y":1460,"width":270,"height":80},
		{"id":"fa5ba6000f53f346","type":"text","text":"It is specifically designed to receive emergency signals and route them to the appropriate police/fire/medical dispatcher. It supports voice, SMS, email, web requests, app-based SOS and other channels.","x":468,"y":1640,"width":368,"height":146},
		{"id":"a53c63b26d509c3f","type":"text","text":"Official Route : 112","x":527,"y":1500,"width":250,"height":60},
		{"id":"ccfe305a90089de5","type":"text","text":"complete incident data goes to the emergency dispatcher\nrather than a specific fire department","x":985,"y":1678,"width":320,"height":108},
		{"id":"ec5dd897b68375dd","type":"text","text":"has to get access to the official fire department","x":1420,"y":1470,"width":250,"height":60},
		{"id":"c4972e1de82d6a52","type":"text","text":"1.) Their provided official channels","x":801,"y":1940,"width":344,"height":58},
		{"id":"1c669ffd5cefd642","type":"text","text":"2.) Official EMail","x":1305,"y":1938,"width":250,"height":60},
		{"id":"a9a078040b15e28f","type":"text","text":"┌──────────────────────────────────────┐\n│ 🚨 FIRE INCIDENT #00142              │\n├──────────────────────────────────────┤\n│                                      │\n│ 📍 LIVE LOCATION                     │\n│ [ MAP ]                              │\n│                                      │\n│ 🚒 NEAREST FIRE STATION              │\n│ XYZ Fire Station — 2.3 km            │\n│                                      │\n│ 👥 POSSIBLE VICTIMS                  │\n│ 4                                    │\n│                                      │\n│ 📷 EVIDENCE                          │\n│ [IMG] [IMG] [IMG]                    │\n│                                      │\n│ 🏢 BUILDING INFORMATION              │\n│ Floor 1 → Floor 4                    │\n│                                      │\n│ 🧠 AI ANALYSIS                       │\n│ Fire probability: HIGH               │\n│                                      │\n│ 🔗 3D MODEL                          │\n│ [OPEN]                               │\n└──────────────────────────────────────┘","x":-77,"y":1681,"width":377,"height":539},
		{"id":"e6f0408c1dc4ac05","type":"text","text":"Production Deployment Path ","x":847,"y":2140,"width":277,"height":50},
