{
	"nodes":[
		{"id":"64108cc36385e665","type":"text","text":"Fire Detection","x":-317,"y":207,"width":250,"height":60},
		{"id":"5e23beabe69fa1d1","type":"text","text":"Human Detection","x":20,"y":207,"width":250,"height":60},
		{"id":"7d4d1745ecaf0054","type":"text","text":"Models YoloV8","x":-140,"y":80,"width":250,"height":50},
		{"id":"32e7da7a65d69a71","type":"text","text":"Frames extract - 2-5 FPS","x":-317,"y":340,"width":250,"height":60},
		{"id":"7c0e8766589b42ff","type":"text","text":"Multi Layer Filter","x":-317,"y":440,"width":250,"height":60},
		{"id":"3847de851e084e3f","type":"text","text":"Detect Fire and its main source","x":-317,"y":560,"width":250,"height":60},
		{"id":"f444952cca8ab5c8","type":"text","text":"images, 3d Hologram (room), location, human count, cctv footages","x":-317,"y":680,"width":250,"height":80},
		{"id":"f340d42e976cdf3d","type":"text","text":"45 sec window","x":-520,"y":960,"width":250,"height":60},
		{"id":"a7f12c389c333c69","type":"text","text":"Fire Departement Contact","x":-40,"y":900,"width":250,"height":60},
		{"id":"98182206d2fa985d","type":"text","text":"Building Owner","x":-520,"y":870,"width":250,"height":60},
		{"id":"46b518df34388fb1","type":"text","text":"Python - OpenCV","x":-660,"y":340,"width":250,"height":60},
		{"id":"be0b05d095b3e9f0","type":"text","text":"Multiple message - to ask wether the actions were taken or not","x":-528,"y":1080,"width":266,"height":100},
		{"id":"cc63a9e1669d9708","type":"text","text":"Full Building for Escape Routes","x":-860,"y":900,"width":250,"height":60},
		{"id":"a151d11fde1bf1dc","type":"text","text":"Web GL","x":-1280,"y":530,"width":250,"height":60},
